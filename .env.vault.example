# Oracle Cloud Vault Configuration
# Copy this file to .env.vault and fill in your actual values
# DO NOT commit .env.vault to version control!

# ===================================
# Oracle Cloud Infrastructure Config
# ===================================

# Your OCI region (e.g., us-ashburn-1, us-phoenix-1, eu-frankfurt-1)
OCI_REGION=us-ashburn-1

# Your compartment OCID where the vault and secrets are located
# Get this from: Identity & Security > Compartments
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaa...

# Your vault OCID
# Get this from: Identity & Security > Vault
OCI_VAULT_ID=ocid1.vault.oc1..aaaaaaaa...

# Your master encryption key OCID
# Get this from: Your Vault > Master Encryption Keys
OCI_KEY_ID=ocid1.key.oc1..aaaaaaaa...

# ===================================
# Authentication Method
# ===================================

# Use instance principal authentication (recommended for compute instances)
# Set to 'true' when running on OCI compute instance
# Set to 'false' when running locally (uses ~/.oci/config)
OCI_USE_INSTANCE_PRINCIPAL=true

# OCI config file location (only used if OCI_USE_INSTANCE_PRINCIPAL=false)
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# ===================================
# Enable/Disable Vault
# ===================================

# Set to 'true' to fetch secrets from Oracle Vault
# Set to 'false' to use traditional environment variables
USE_ORACLE_VAULT=true

# ===================================
# Secret OCIDs
# ===================================
# After creating secrets using scripts/create-vault-secrets.sh,
# copy the OCIDs here from .env.vault.generated

# PostgreSQL password secret OCID
SECRET_POSTGRES_PASSWORD_OCID=ocid1.vaultsecret.oc1..aaaaaaaa...

# Google AI API key secret OCID
SECRET_GOOGLE_API_KEY_OCID=ocid1.vaultsecret.oc1..aaaaaaaa...

# Firebase project ID secret OCID
SECRET_FIREBASE_PROJECT_ID_OCID=ocid1.vaultsecret.oc1..aaaaaaaa...

# Firebase client email secret OCID
SECRET_FIREBASE_CLIENT_EMAIL_OCID=ocid1.vaultsecret.oc1..aaaaaaaa...

# Firebase private key secret OCID
SECRET_FIREBASE_PRIVATE_KEY_OCID=ocid1.vaultsecret.oc1..aaaaaaaa...

# ===================================
# Non-Secret Configuration
# ===================================
# These don't need to be secrets, so they're defined here

# Database configuration
POSTGRES_USER=system
POSTGRES_DB=mockinterview

# Authentication
AUTH_ENABLED=true

# ===================================
# Instructions
# ===================================
# 
# 1. Create vault and master key:
#    - Go to OCI Console > Identity & Security > Vault
#    - Create a new vault
#    - Create a master encryption key (HSM-protected)
#
# 2. Create secrets using the script:
#    chmod +x scripts/create-vault-secrets.sh
#    ./scripts/create-vault-secrets.sh
#
# 3. Copy OCIDs from .env.vault.generated to this file
#
# 4. Configure IAM policies:
#    - Create dynamic group for your compute instances
#    - Create policy to allow reading secrets
#    - See ORACLE_VAULT_SETUP.md for detailed instructions
#
# 5. Deploy with vault-enabled compose file:
#    docker-compose -f docker-compose.vault.yaml up -d
